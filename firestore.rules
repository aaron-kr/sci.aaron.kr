// Paste into: Firebase Console → Firestore Database → Rules tab
// Replace OWNER_EMAIL with your actual Google account email before publishing.
// This file is a reference template — the real, deployed rules (with your
// real email) live only in the Firebase Console, never in this repo.
// Same pattern as courses.aaron.kr/attend's firestore.rules.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Owner check ──────────────────────────────────────────────
    // Client code "reads" this doc (it doesn't need to exist) to find out
    // whether the signed-in user is really the owner: the read succeeds
    // only if the rule below matches, which is the one place the owner's
    // identity is ever checked. This is how the site tells "you signed in
    // with some Google account" apart from "you signed in as the owner" —
    // without ever needing to know or store your email client-side.
    match /meta/owner_check {
      allow get: if request.auth != null
                 && request.auth.token.email == "OWNER_EMAIL";
    }

    // ── Bookmarks (research hearts + news bookmarks + "mark for class") ──
    // Public read (harmless — this is just "Aaron marked this," and it lets
    // the Reading List page render without requiring visitors to sign in).
    // Only the owner can write. kind: "research" | "news" | "class" — the
    // active/current state; unmarking (or "Clear all") deletes the doc.
    match /bookmarks/{id} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "OWNER_EMAIL";
    }

    // ── Permanent semester log (research marked for class only) ─────
    // Append-only from the UI's perspective: "Clear all" on This week's
    // set only touches /bookmarks above, never this — the semester reading
    // list (grouped by week) reads from here so it survives weekly resets.
    match /class_log/{id} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "OWNER_EMAIL";
    }
  }
}
